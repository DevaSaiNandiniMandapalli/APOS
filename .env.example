# Server-only AI configuration (Sarvam 105B). Never commit real values.
SARVAM_API_KEY=
SARVAM_API_URL=https://api.sarvam.ai/v1/chat/completions
SARVAM_MODEL=sarvam-105b

# Optional APOS processing server. The URL is public build-time configuration.
# NEXT_PUBLIC_APOS_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APOS_MAX_UPLOAD_MB=50
APOS_MAX_FILES=20
APOS_MAX_OUTPUT_MB=100
APOS_RATE_LIMIT_REQUESTS=120
APOS_RATE_LIMIT_WINDOW=60

# Optional server AI extra.
# ANTHROPIC_API_KEY=
